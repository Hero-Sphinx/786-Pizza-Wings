# Copy to .env for local development. Real values live only in .env (gitignored) and the host's env settings.

# Postgres. Local: `npm run dev:db` then use this URL. Production: your Neon pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/pizza"

# Public site URL, used in order emails (no trailing slash).
APP_URL="http://localhost:3000"

# Long random string used to hash client IPs for rate limiting. Required in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SECRET=""

# Optional: new-order emails through Gmail SMTP with an app password.
# Set the store's inbox in /admin/settings ("Email new orders to").
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
